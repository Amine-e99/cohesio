# Cohesio — environment variables (no real values here)
#
# This file lists the variables for three processes. Copy each block into the
# .env file indicated. .env files are git-ignored; never commit real values.
#
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SCOPES and SHOPIFY_APP_URL are injected
# by `shopify app dev` locally, and set as App Service settings in production.

# --- ./.env  (React Router app) ---------------------------------------------
# PostgreSQL connection string used by Prisma
DATABASE_URL=
# Base URL of the Python engine, e.g. http://localhost:8000 in development
ENGINE_URL=
# Shared secret sent in the X-Engine-Key header; must match engine/.env
ENGINE_API_KEY=

# --- ./engine/.env  (Python engine) -----------------------------------------
# DATABASE_URL=
# ENGINE_API_KEY=

# --- ./scripts/seed/.env  (separate seed app, development store only) -------
# Store subdomain, without ".myshopify.com"
# SHOPIFY_SHOP=
# Client ID and secret of the seed app (not the Cohesio app)
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

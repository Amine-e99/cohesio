// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  // l'adresse de la base vient du .env, jamais du code
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
model OrderLine {
  id          Int      @id @default(autoincrement())
  shopId      String   @map("shop_id")     // ex. cohesio.myshopify.com
  orderId     String   @map("order_id")    // gid Shopify de la commande
  productId   String   @map("product_id")  // gid Shopify du produit
  quantity    Int
  processedAt DateTime @map("processed_at") // date réelle de la commande

  @@unique([shopId, orderId, productId])   // idempotence : pas de doublon
  @@index([shopId, productId, processedAt]) // stock mort : dernière vente par produit
  @@map("order_lines")
}
model Product {
  id        Int      @id @default(autoincrement())
  shopId    String   @map("shop_id")
  productId String   @map("product_id")  // gid Shopify du produit
  title     String
  status    String                       // ACTIVE, DRAFT, ARCHIVED
  createdAt DateTime @map("created_at")  // date de création côté Shopify
  handle       String                              // URL vitrine : /products/<handle>
  imageUrl     String? @map("image_url")           // image principale
  price        String?                             // prix minimum des variantes (decimal en texte)
  currencyCode String? @map("currency_code")

  @@unique([shopId, productId])
  @@map("products")
}

model ProductPair {
  id         Int      @id @default(autoincrement())
  shopId     String   @map("shop_id")
  productA   String   @map("product_a")
  productB   String   @map("product_b")
  coCount    Int      @map("co_count")
  support    Float
  confidence Float
  lift       Float
  computedAt DateTime @map("computed_at")

  @@unique([shopId, productA, productB])
  @@index([shopId, productA])            // recommandations pour un produit
  @@map("product_pairs")
}

model ProductStat {
  id             Int       @id @default(autoincrement())
  shopId         String    @map("shop_id")
  productId      String    @map("product_id")
  totalQty       Int       @map("total_qty")
  ordersCount    Int       @map("orders_count")
  lastSoldAt     DateTime? @map("last_sold_at")
  classification String
  computedAt     DateTime  @map("computed_at")

  @@unique([shopId, productId])
  @@map("product_stats")
}

model ShopSettings {
  id            Int      @id @default(autoincrement())
  shopId        String   @unique @map("shop_id")
  minCoCount    Int      @default(8) @map("min_co_count")       // commandes communes minimum
  minConfidence Float    @default(0.2) @map("min_confidence")   // fraction 0–1
  minLift       Float    @default(1.5) @map("min_lift")
  deadDays      Int      @default(30) @map("dead_days")         // jours sans vente -> à déstocker
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}

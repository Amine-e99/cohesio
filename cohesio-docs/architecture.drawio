<mxfile host="app.diagrams.net">
  <diagram name="Architecture Cohesio" id="cohesio-archi">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titre -->
        <mxCell id="title" value="&lt;b&gt;Cohesio — architecture&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Zones -->
        <mxCell id="zone1" value="1. Analyse — côté marchand (admin Shopify)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#666666;arcSize=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="1110" height="380" as="geometry" />
        </mxCell>
        <mxCell id="zone2" value="2. Affichage — côté client (boutique)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#666666;arcSize=4;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="1110" height="140" as="geometry" />
        </mxCell>

        <!-- Noeuds -->
        <mxCell id="shopify" value="&lt;b&gt;Boutique Shopify&lt;/b&gt;&lt;br&gt;GraphQL Admin API&lt;br&gt;Webhooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="remix" value="&lt;b&gt;App Remix&lt;/b&gt;&lt;br&gt;OAuth · dashboard Polaris&lt;br&gt;webhooks · App Proxy&lt;br&gt;&lt;i&gt;(Azure)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;order_lines&lt;br&gt;product_pairs&lt;br&gt;product_stats&lt;br&gt;&lt;i&gt;(Azure)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="250" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="python" value="&lt;b&gt;Moteur Python&lt;/b&gt;&lt;br&gt;FastAPI · Pandas · mlxtend&lt;br&gt;&lt;i&gt;(Azure)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="480" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="theme" value="&lt;b&gt;Page produit&lt;/b&gt;&lt;br&gt;bloc « Fréquemment achetés ensemble »&lt;br&gt;(Theme App Extension)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="&lt;b&gt;App Proxy Shopify&lt;/b&gt;&lt;br&gt;ajoute une signature HMAC&lt;br&gt;+ l'identité de la boutique" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="650" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Flux analyse -->
        <mxCell id="e1" value="① lance la Bulk Operation (GraphQL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="remix" target="shopify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="② fichier JSONL (import initial, une fois)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="shopify" target="remix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="③ webhook orders/create (à chaque commande)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="shopify" target="remix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="④ écrit&lt;br&gt;order_lines" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="remix" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="⑤ demande de recalcul (asynchrone)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="remix" target="python">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="⑥ lit&lt;br&gt;order_lines" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg" target="python">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-45" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="⑦ écrit&lt;br&gt;product_pairs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="python" target="pg">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Flux affichage -->
        <mxCell id="eA" value="A · fetch /apps/cohesio/paires ⇄ JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="theme" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eB" value="B · requête signée ⇄ JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy" target="remix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eC" value="C · lit&lt;br&gt;product_pairs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg" target="remix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Légende -->
        <mxCell id="legend" value="&lt;b&gt;Lecture :&lt;/b&gt; une flèche part de celui qui déclenche l'échange. Trait plein = requête initiée par la source · pointillés = événement poussé par Shopify · double flèche = requête ⇄ réponse.&lt;br&gt;La base PostgreSQL est unique : c'est elle qui relie la partie analyse à la partie affichage." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="760" width="1110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Webhooks et App Proxy : signature HMAC vérifiée par Remix avant tout traitement." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="700" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
